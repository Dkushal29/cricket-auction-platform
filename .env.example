# Environment Variables Configuration

# MongoDB Atlas Connection URL (Replica Set / Atlas cluster required for Prisma transactions):
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database_name>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://admin:password@cluster0.mongodb.net/cricket_auction_prod?retryWrites=true&w=majority"

# JWT Authentication Secret (Minimum 32 characters high entropy string)
JWT_SECRET="your-production-jwt-secret-key-min-32-chars-2026"

# Server Port and Host Configuration
PORT=3000
HOSTNAME="0.0.0.0"

# Public WebSocket / App Origin URL (Optional, defaults dynamically to window.location.origin)
NEXT_PUBLIC_SOCKET_URL=""
